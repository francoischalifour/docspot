{
  "name": "docspot-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter docspot build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter docspot test",
    "lint": "oxlint -c oxlint.json --type-aware --deny-warnings packages examples",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun run format:check && bun run lint && bun run build && bun run typecheck && bun run test && bun run --filter docspot check:package && bun run --filter docspot size && bun run --filter docspot bench",
    "size": "bun run --filter docspot size",
    "bench": "bun run --filter docspot bench"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "packageManager": "bun@1.4.5"
}
