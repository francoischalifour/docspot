{
  "name": "docspot-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter docspot build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter docspot test",
    "lint": "oxlint --deny-warnings packages examples",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run build && bun run typecheck && bun run test && bun run --filter docspot check:package"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "packageManager": "bun@1.4.4"
}
