{
  "name": "docspot",
  "version": "0.1.0",
  "description": "Documentation search and AI chat for React: search-only, chat-only, or both.",
  "keywords": [
    "ai",
    "ai-sdk",
    "algolia",
    "chat",
    "documentation",
    "minisearch",
    "react",
    "search"
  ],
  "homepage": "https://github.com/francoischalifour/docspot/tree/main/packages/docspot#readme",
  "bugs": "https://github.com/francoischalifour/docspot/issues",
  "license": "MIT",
  "author": "Francois Chalifour <francois.chalifour@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francoischalifour/docspot.git",
    "directory": "packages/docspot"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    },
    "./algolia": {
      "types": "./dist/algolia.d.ts",
      "default": "./dist/algolia.js"
    },
    "./algolia-chat": {
      "types": "./dist/algolia-chat.d.ts",
      "default": "./dist/algolia-chat.js"
    },
    "./minisearch": {
      "types": "./dist/minisearch.d.ts",
      "default": "./dist/minisearch.js"
    },
    "./handoffs": {
      "types": "./dist/handoffs.d.ts",
      "default": "./dist/handoffs.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css && bun scripts/check-isolation.ts && bun scripts/check-tree-shaking.ts && bun scripts/check-ssr.tsx",
    "prepublishOnly": "bun run --cwd ../.. check"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.19.12",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.167",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "ai": "7.0.163",
    "minisearch": "7.2.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.16",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^2.0.0",
    "ai": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
