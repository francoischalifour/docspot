{
  "name": "docspot",
  "version": "0.3.0",
  "description": "Docs search and Ask AI for React. Any search backend, any AI model, accessible and keyboard-first.",
  "keywords": [
    "ai-chat",
    "ai-sdk",
    "algolia",
    "ask-ai",
    "chatbot",
    "cmdk",
    "command-menu",
    "command-palette",
    "docs",
    "docs-search",
    "docsearch",
    "documentation",
    "documentation-search",
    "i18n",
    "llm",
    "minisearch",
    "rag",
    "react",
    "react-component",
    "search",
    "search-dialog",
    "site-search",
    "typescript"
  ],
  "homepage": "https://github.com/francoischalifour/docspot",
  "bugs": "https://github.com/francoischalifour/docspot/issues",
  "license": "MIT",
  "author": {
    "name": "François Chalifour",
    "email": "francois.chalifour@gmail.com",
    "url": "https://francoischalifour.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francoischalifour/docspot.git",
    "directory": "packages/docspot"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    },
    "./algolia": {
      "types": "./dist/algolia.d.ts",
      "default": "./dist/algolia.js"
    },
    "./algolia-chat": {
      "types": "./dist/algolia-chat.d.ts",
      "default": "./dist/algolia-chat.js"
    },
    "./minisearch": {
      "types": "./dist/minisearch.d.ts",
      "default": "./dist/minisearch.js"
    },
    "./handoffs": {
      "types": "./dist/handoffs.d.ts",
      "default": "./dist/handoffs.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "default": "./dist/locale.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "bun check && bun check -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css && bun scripts/check-isolation.ts && bun scripts/check-tree-shaking.ts && bun scripts/check-ssr.tsx",
    "prepublishOnly": "bun run --cwd ../.. check",
    "size": "bun scripts/size.ts",
    "bench": "bun scripts/bench.ts"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.19.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@ai-sdk/react": "2.0.288",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "1.4.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "ai": "5.0.285",
    "axe-core": "4.14.1",
    "minisearch": "7.2.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rolldown": "1.2.16",
    "tsdown": "0.23.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "minisearch": "^6.0.0 || ^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "minisearch": {
      "optional": true
    }
  }
}
